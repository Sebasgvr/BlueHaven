{
  "name": "blue-haven",
  "version": "2.0.0",
  "private": true,
  "description": "Juego educativo de pesca 3D",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "test:browser": "node tests/browser.cjs",
    "test:api": "node tests/supabase-api.cjs",
    "optimize:shop": "node scripts/optimizar-tienda.mjs",
    "build:vendor": "esbuild scripts/supabase-entry.js --bundle --minify --format=iife --global-name=SupabaseSDK --outfile=libraries/supabase.min.js --legal-comments=linked",
    "configure:supabase": "node scripts/configurar-supabase.cjs",
    "db:seed": "node scripts/generar-semilla.cjs",
    "test:supabase": "sh scripts/probar-supabase.sh",
    "test:browser:supabase": "node tests/supabase-browser.cjs",
    "test:shop": "node tests/shop-browser.cjs",
    "test:settings": "node tests/settings-browser.cjs",
    "test:captures": "node tests/capture-browser.cjs",
    "test:forest": "node tests/forest-browser.cjs",
    "test:mobile": "node tests/mobile-browser.cjs",
    "build:pwa": "node scripts/generar-pwa.cjs",
    "test:pwa": "node tests/pwa-browser.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "esbuild": "^0.28.2",
    "playwright": "^1.65.0",
    "sharp": "^0.35.5"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0"
  }
}
